<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UIAppFonts</key><array><string>Caveat-Medium.ttf</string><string>InstrumentSerif-Regular.ttf</string><string>LXGWWenKai-Regular.ttf</string><string>SpaceMono-Bold.ttf</string><string>SpaceMono-Regular.ttf</string></array>
    <key>CFBundleDisplayName</key><string>Lumi</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Lumi 使用麦克风把通话中的声音转换为文字发送给沈屿。</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>藏宝地图需要当前位置来判断你是否走到信件附近，并在你确认后记录足迹。</string>
    <key>NSLocalNetworkUsageDescription</key><string>Lumi 需要连接你这台 Mac 上专用的外卖助手，并把订单预览卡片发回聊天。</string>
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>LUMI_TAKEOUT_BRIDGE_HOST</key><string>yanyandeMacBook-Air.local</string>
    <key>UIBackgroundModes</key><array><string>voip</string><string>audio</string></array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict><key>CFBundleURLName</key><string>com.cai5232.LumiPush.call</string><key>CFBundleURLSchemes</key><array><string>lumi</string></array></dict>
        <dict><key>CFBundleURLName</key><string>com.cai5232.LumiPush.calendar</string><key>CFBundleURLSchemes</key><array><string>ourcalendar</string></array></dict>
    </array>
    <key>NSSpeechRecognitionUsageDescription</key><string>Lumi 使用语音识别把通话中的声音转换为文字发送给沈屿。</string>
    <key>NSUserActivityTypes</key>
    <array><string>INSendMessageIntent</string></array>
    <key>UIApplicationSceneManifest</key>
    <dict><key>UIApplicationSupportsMultipleScenes</key><true/></dict>
    <key>UILaunchScreen</key><dict/>
    <key>UIRequiresFullScreen</key><true/>
</dict>
</plist>
